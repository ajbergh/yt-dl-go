{
  "name": "youtube-downloader-ui",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1",
    "build": "vite build --configLoader runner",
    "check": "npm run typecheck && npm run build:check && npm run lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build:check": "node scripts/build-check.mjs",
    "lint": "eslint .",
    "licenses:generate": "node scripts/generate-npm-notices.mjs",
    "licenses:generate:go": "node scripts/generate-go-notices.mjs",
    "licenses:check": "node scripts/check-license-drift.mjs",
    "preview": "vite preview",
    "e2e:browser": "node scripts/browser-e2e.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "lucide-react": "^1.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^17.12.0",
    "happy-dom": "20.11.14",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.39.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "@typescript-eslint/types": "8.39.0",
    "@typescript-eslint/tsconfig-utils": "8.39.0"
  }
}
